@page "/not-found"
@layout MainLayout

<PageTitle>No encontrado · PruebaOben</PageTitle>
<div class="empty-state page-not-found">
    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h5">No encontramos esa página</MudText>
    <MudText Typo="Typo.body2" Class="muted-text">Comprueba la dirección o vuelve al resumen.</MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Ir al resumen</MudButton>
</div>
