@page "/audit"
@inject ApiClient Api

<PageTitle>Auditoría · PruebaOben</PageTitle>

<div class="page-heading">
    <div>
        <MudText Typo="Typo.overline" Class="eyebrow">TRAZABILIDAD</MudText>
        <MudText Typo="Typo.h4" Class="page-title">Auditoría</MudText>
        <MudText Typo="Typo.body1" Class="muted-text">Historial de operaciones registradas en la base de datos.</MudText>
    </div>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="@(() => LoadPageAsync(_page))">
        Actualizar
    </MudButton>
</div>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="audit-note">
    El actor y el usuario afectado se muestran como IDs. Si el actor aparece como “No informado”, el backend todavía no configuró SESSION_CONTEXT para esa operación.
</MudAlert>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}

<MudPaper Elevation="0" Class="content-card">
    <div class="section-heading table-toolbar">
        <div>
            <MudText Typo="Typo.h6">Registro de cambios</MudText>
            <MudText Typo="Typo.body2" Class="muted-text">@_totalCount eventos encontrados</MudText>
        </div>
        <MudSelect T="int" Label="Filas por página" Value="_pageSize" ValueChanged="ChangePageSizeAsync"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="page-size-select">
            <MudSelectItem Value="25">25</MudSelectItem>
            <MudSelectItem Value="50">50</MudSelectItem>
            <MudSelectItem Value="100">100</MudSelectItem>
        </MudSelect>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_items.Count == 0)
    {
        <div class="empty-state">
            <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" />
            <MudText Typo="Typo.body1">No hay cambios registrados.</MudText>
        </div>
    }
    else
    {
        <MudTable Items="_items" Dense="true" Hover="true" Breakpoint="Breakpoint.Md" Elevation="0" Class="data-table audit-table">
            <HeaderContent>
                <MudTh>Acción</MudTh><MudTh>Entidad / campo</MudTh><MudTh>Usuario afectado</MudTh><MudTh>Actor</MudTh><MudTh>Valores</MudTh><MudTh>Fecha</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Acción"><MudChip T="string" Size="Size.Small" Color="@ActionColor(context.accion)" Variant="Variant.Outlined">@context.accion</MudChip></MudTd>
                <MudTd DataLabel="Entidad / campo">
                    <MudText Typo="Typo.body2">@context.entidad</MudText>
                    @if (!string.IsNullOrWhiteSpace(context.nombreCampo))
                    {
                        <MudText Typo="Typo.caption" Class="muted-text">@context.nombreCampo</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Usuario afectado">@(AffectedUserId(context)?.ToString() ?? "—")</MudTd>
                <MudTd DataLabel="Actor">@(context.cambioRealizado?.ToString() ?? "No informado")</MudTd>
                <MudTd DataLabel="Valores">
                    @if (context.nombreCampo is not null)
                    {
                        <MudText Typo="Typo.caption" Class="audit-value">@(context.valorAnterior ?? "∅") → @(context.valorNuevo ?? "∅")</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="muted-text">—</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Fecha">@context.cambioAt.ToLocalTime().ToString("g")</MudTd>
            </RowTemplate>
        </MudTable>
        <div class="pagination-row">
            <MudText Typo="Typo.caption" Class="muted-text">Página @_page de @PageCount</MudText>
            <MudPagination Count="@PageCount" Selected="@_page" SelectedChanged="LoadPageAsync"
                           Color="Color.Primary" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" />
        </div>
    }
</MudPaper>

@code {
    private IReadOnlyList<AuditLogDto> _items = [];
    private int _page = 1;
    private int _pageSize = 50;
    private long _totalCount;
    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)_totalCount / _pageSize));
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadPageAsync(1);

    private async Task LoadPageAsync(int page)
    {
        _page = page;
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetAuditAsync(_page, _pageSize);
            _items = result.items;
            _totalCount = result.totalCount;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ChangePageSizeAsync(int pageSize)
    {
        _pageSize = pageSize;
        return LoadPageAsync(1);
    }

    private static Color ActionColor(string action) => action switch
    {
        "INSERT" => Color.Success,
        "DELETE" => Color.Error,
        _ => Color.Info
    };

    private static int? AffectedUserId(AuditLogDto audit) =>
        audit.userId ?? (audit.entidad == "users" ? audit.entidadId : null);
}
