@page "/users"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Usuarios · PruebaOben</PageTitle>

<div class="page-heading">
    <div>
        <MudText Typo="Typo.overline" Class="eyebrow">ADMINISTRACIÓN</MudText>
        <MudText Typo="Typo.h4" Class="page-title">Usuarios</MudText>
        <MudText Typo="Typo.body1" Class="muted-text">Consulta y administra las cuentas registradas.</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="CreateUserAsync">
        Nuevo usuario
    </MudButton>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}

<MudPaper Elevation="0" Class="content-card">
    <div class="section-heading">
        <MudText Typo="Typo.h6">Directorio</MudText>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_users.Count == 0)
    {
        <div class="empty-state">
            <MudIcon Icon="@Icons.Material.Filled.PeopleOutline" Size="Size.Large" />
            <MudText Typo="Typo.body1">No hay usuarios para mostrar.</MudText>
        </div>
    }
    else
    {
        <MudTable Items="FilteredUsers" Dense="true" Hover="true" Breakpoint="Breakpoint.None"
                  Elevation="0" Class="data-table users-table">
            <ToolBarContent>
                <div class="users-table-toolbar">
                    <MudText Typo="Typo.body2" Class="muted-text">@FilteredUsers.Count() usuarios visibles</MudText>
                    <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar usuario…"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                  Class="users-search-field" />
                </div>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Usuario</MudTh><MudTh>Correo</MudTh><MudTh>Rol</MudTh><MudTh>Estado</MudTh><MudTh>Creado</MudTh><MudTh>Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Usuario">
                    <div class="user-cell">
                        <MudAvatar Size="Size.Small" Color="Color.Primary">@Initial(context.fullname)</MudAvatar>
                        <div><MudText Typo="Typo.body2" Class="user-fullname">@context.fullname</MudText><MudText Typo="Typo.caption" Class="muted-text">@context.username</MudText></div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Correo">@context.email</MudTd>
                <MudTd DataLabel="Rol"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.rol</MudChip></MudTd>
                <MudTd DataLabel="Estado">
                    @if (context.deletedAt is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">Eliminado lógicamente</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="@(context.active ? Color.Success : Color.Default)" Variant="Variant.Outlined">@(context.active ? "Activo" : "Inactivo")</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Creado">@context.createdAt.ToLocalTime().ToString("d")</MudTd>
                <MudTd DataLabel="Acciones" Class="actions-cell">
                    @if (context.deletedAt is null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" title="Editar usuario" OnClick="@(() => EditUserAsync(context))" />
                    }
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" title="Más acciones" Dense="true">
                        @if (context.deletedAt is null)
                        {
                            <MudMenuItem Icon="@(context.active ? Icons.Material.Filled.PersonOff : Icons.Material.Filled.Person)"
                                         OnClick="@(() => SetActiveAsync(context, !context.active))">
                                @(context.active ? "Desactivar cuenta" : "Activar cuenta")
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Filled.DeleteOutline"
                                         OnClick="@(() => DeleteUserAsync(context))">
                                Eliminar lógicamente
                            </MudMenuItem>
                        }
                        <AuthorizeView Roles="Admin">
                            <Authorized Context="authorizationState">
                                <MudMenuItem Icon="@Icons.Material.Filled.DeleteForever"
                                             OnClick="@(() => PermanentlyDeleteUserAsync(context))">
                                    Eliminar permanentemente
                                </MudMenuItem>
                            </Authorized>
                        </AuthorizeView>
                    </MudMenu>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private IReadOnlyList<UserDto> _users = [];
    private string _search = string.Empty;
    private string? _error;
    private bool _loading = true;

    private IEnumerable<UserDto> FilteredUsers => string.IsNullOrWhiteSpace(_search)
        ? _users
        : _users.Where(user =>
            user.username.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || user.fullname.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || user.email.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var isAdmin = authenticationState.User.IsInRole("Admin");
            _users = await Api.GetUsersAsync(includeDeleted: isAdmin);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateUserAsync()
    {
        var result = await ShowUserDialogAsync("Crear usuario");
        if (result is null)
        {
            return;
        }

        AddOrReplaceUser(result);
        Snackbar.Add("El usuario se creó correctamente.", Severity.Success);
    }

    private async Task EditUserAsync(UserDto user)
    {
        var result = await ShowUserDialogAsync("Editar usuario", user);
        if (result is null)
        {
            return;
        }

        AddOrReplaceUser(result);
        Snackbar.Add("Los cambios del usuario se guardaron.", Severity.Success);
    }

    private async Task<UserDto?> ShowUserDialogAsync(string title, UserDto? user = null)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { dialog => dialog.User, user }
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            BackdropClick = false,
            FullWidth = true,
            MaxWidth = MaxWidth.Medium
        };

        var dialog = await DialogService.ShowAsync<UserDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: UserDto updatedUser }
            ? updatedUser
            : null;
    }

    private async Task SetActiveAsync(UserDto user, bool active)
    {
        if (!active && !await ConfirmAsync(
            "Desactivar cuenta",
            $"La cuenta de {user.fullname} quedará inactiva, pero sus datos se conservarán.",
            "Desactivar cuenta",
            MaxWidth.ExtraSmall))
        {
            return;
        }

        _error = null;
        try
        {
            await Api.SetUserActiveAsync(user, active);
            AddOrReplaceUser(CopyUser(user, active));
            Snackbar.Add(
                active
                    ? $"Se activó la cuenta de {user.fullname}."
                    : $"Se desactivó la cuenta de {user.fullname}.",
                Severity.Success);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
    }

    private async Task DeleteUserAsync(UserDto user)
    {
        if (!await ConfirmAsync(
            "Eliminar lógicamente",
            $"El usuario {user.fullname} dejará de aparecer en el sistema. Sus datos se conservarán como borrado lógico.",
            "Eliminar lógicamente",
            MaxWidth.Small))
        {
            return;
        }

        _error = null;
        try
        {
            await Api.DeleteUserAsync(user.id);
            AddOrReplaceUser(CopyUser(user, active: false, deletedAt: DateTime.UtcNow));
            Snackbar.Add($"Se eliminó lógicamente a {user.fullname}.", Severity.Success);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
    }

    private async Task PermanentlyDeleteUserAsync(UserDto user)
    {
        if (!await ConfirmAsync(
            "Eliminar permanentemente",
            $"Se borrarán definitivamente los datos de {user.fullname}. Solo quedará en auditoría su ID, username y nombre completo. Esta acción no se puede deshacer.",
            "Eliminar permanentemente",
            MaxWidth.Small))
        {
            return;
        }

        _error = null;
        try
        {
            await Api.PermanentlyDeleteUserAsync(user.id);
            RemoveUser(user.id);
            Snackbar.Add($"Se eliminó permanentemente a {user.fullname}.", Severity.Success);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
    }

    private async Task<bool> ConfirmAsync(
        string title,
        string message,
        string confirmText,
        MaxWidth maxWidth)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, message },
            { dialog => dialog.ConfirmText, confirmText }
        };
        var confirmation = await DialogService.ShowAsync<ConfirmDialog>(
            title,
            parameters,
            new DialogOptions { MaxWidth = maxWidth, FullWidth = true });
        var result = await confirmation.Result;
        return result is { Canceled: false, Data: true };
    }

    private static UserDto CopyUser(UserDto user, bool active, DateTime? deletedAt = null) =>
        new()
        {
            id = user.id,
            username = user.username,
            fullname = user.fullname,
            email = user.email,
            rol = user.rol,
            active = active,
            createdAt = user.createdAt,
            updatedAt = user.updatedAt,
            deletedAt = deletedAt
        };

    private void RemoveUser(int userId) =>
        _users = _users.Where(user => user.id != userId).ToList();

    private void AddOrReplaceUser(UserDto user)
    {
        var users = _users.ToList();
        var index = users.FindIndex(existing => existing.id == user.id);
        if (index < 0)
        {
            users.Insert(0, user);
        }
        else
        {
            users[index] = user;
        }

        _users = users;
    }

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpperInvariant();

}
