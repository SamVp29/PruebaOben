@page "/users"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Usuarios · PruebaOben</PageTitle>

<div class="page-heading">
    <div>
        <MudText Typo="Typo.overline" Class="eyebrow">ADMINISTRACIÓN</MudText>
        <MudText Typo="Typo.h4" Class="page-title">Usuarios</MudText>
        <MudText Typo="Typo.body1" Class="muted-text">Consulta y administra las cuentas registradas.</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="CreateUserAsync">
        Nuevo usuario
    </MudButton>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}

<MudPaper Elevation="0" Class="content-card">
    <div class="section-heading table-toolbar">
        <div>
            <MudText Typo="Typo.h6">Directorio</MudText>
            <MudText Typo="Typo.body2" Class="muted-text">@FilteredUsers.Count() usuarios visibles</MudText>
        </div>
        <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar usuario…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                      Class="search-field" />
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_users.Count == 0)
    {
        <div class="empty-state">
            <MudIcon Icon="@Icons.Material.Filled.PeopleOutline" Size="Size.Large" />
            <MudText Typo="Typo.body1">No hay usuarios para mostrar.</MudText>
        </div>
    }
    else
    {
        <MudTable Items="FilteredUsers" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                  Elevation="0" Class="data-table">
            <HeaderContent>
                <MudTh>Usuario</MudTh><MudTh>Correo</MudTh><MudTh>Rol</MudTh><MudTh>Estado</MudTh><MudTh>Creado</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Usuario">
                    <div class="user-cell">
                        <MudAvatar Size="Size.Small" Color="Color.Primary">@Initial(context.fullname)</MudAvatar>
                        <div><MudText Typo="Typo.body2" Class="user-fullname">@context.fullname</MudText><MudText Typo="Typo.caption" Class="muted-text">@context.username</MudText></div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Correo">@context.email</MudTd>
                <MudTd DataLabel="Rol"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.rol</MudChip></MudTd>
                <MudTd DataLabel="Estado"><MudChip T="string" Size="Size.Small" Color="@(context.active ? Color.Success : Color.Default)" Variant="Variant.Outlined">@(context.active ? "Activo" : "Inactivo")</MudChip></MudTd>
                <MudTd DataLabel="Creado">@context.createdAt.ToLocalTime().ToString("d")</MudTd>
                <MudTd DataLabel="Acciones" Class="actions-cell">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" title="Editar usuario" OnClick="@(() => EditUserAsync(context))" />
                    @if (context.active)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.PersonOff" Color="Color.Warning" title="Desactivar cuenta" OnClick="@(() => DeactivateAsync(context))" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" title="Eliminar usuario" OnClick="@(() => DeleteUserAsync(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private IReadOnlyList<UserDto> _users = [];
    private string _search = string.Empty;
    private string? _error;
    private bool _loading = true;

    private IEnumerable<UserDto> FilteredUsers => string.IsNullOrWhiteSpace(_search)
        ? _users
        : _users.Where(user =>
            user.username.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || user.fullname.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || user.email.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _users = await Api.GetUsersAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateUserAsync()
    {
        var result = await ShowUserDialogAsync("Crear usuario");
        if (result is null)
        {
            return;
        }

        AddOrReplaceUser(result);
        Snackbar.Add("El usuario se creó correctamente.", Severity.Success);
    }

    private async Task EditUserAsync(UserDto user)
    {
        var result = await ShowUserDialogAsync("Editar usuario", user);
        if (result is null)
        {
            return;
        }

        AddOrReplaceUser(result);
        Snackbar.Add("Los cambios del usuario se guardaron.", Severity.Success);
    }

    private async Task<UserDto?> ShowUserDialogAsync(string title, UserDto? user = null)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { dialog => dialog.User, user }
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            BackdropClick = false,
            FullWidth = true,
            MaxWidth = MaxWidth.Medium
        };

        var dialog = await DialogService.ShowAsync<UserDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: UserDto updatedUser }
            ? updatedUser
            : null;
    }

    private async Task DeactivateAsync(UserDto user)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, $"¿Deseas desactivar la cuenta de {user.fullname}? La cuenta quedará inactiva, pero seguirá en el sistema." },
            { dialog => dialog.ConfirmText, "Desactivar cuenta" }
        };
        var confirmation = await DialogService.ShowAsync<ConfirmDialog>(
            "Desactivar cuenta",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await confirmation.Result;
        if (result is not { Canceled: false, Data: true })
        {
            return;
        }

        _error = null;
        try
        {
            await Api.DeactivateUserAsync(user);
            AddOrReplaceUser(new UserDto
            {
                id = user.id,
                username = user.username,
                fullname = user.fullname,
                email = user.email,
                rol = user.rol,
                active = false,
                createdAt = user.createdAt,
                updatedAt = user.updatedAt
            });
            Snackbar.Add($"Se desactivó la cuenta de {user.fullname}.", Severity.Success);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
    }

    private async Task DeleteUserAsync(UserDto user)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, $"¿Deseas eliminar a {user.fullname}? El usuario dejará de aparecer en el sistema; esta acción es un borrado lógico." },
            { dialog => dialog.ConfirmText, "Eliminar usuario" }
        };
        var confirmation = await DialogService.ShowAsync<ConfirmDialog>(
            "Eliminar usuario",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await confirmation.Result;
        if (result is not { Canceled: false, Data: true })
        {
            return;
        }

        _error = null;
        try
        {
            await Api.DeleteUserAsync(user.id);
            _users = _users.Where(existing => existing.id != user.id).ToList();
            Snackbar.Add($"Se eliminó el usuario {user.fullname}.", Severity.Success);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
    }

    private void AddOrReplaceUser(UserDto user)
    {
        var users = _users.ToList();
        var index = users.FindIndex(existing => existing.id == user.id);
        if (index < 0)
        {
            users.Insert(0, user);
        }
        else
        {
            users[index] = user;
        }

        _users = users;
    }

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpperInvariant();

}
